# RFP §14, §690 — every setting comes from the environment.
# Copy this file to .env and fill in the values. .env is gitignored.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only, and scripts/deploy.sh refuses without it. Behind a proxy
# Django cannot infer the scheme, so every form POST fails CSRF until this
# names the site with its https:// prefix. Must contain DOMAIN below.
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.mn

# Database — RFP §14 forbids SQLite in production
DATABASE_URL=postgres://kinder:kinder@db:5432/kinder

# Production only. docker-compose.prod.yml creates the database from these,
# and DATABASE_URL above has to name the same user, password and database —
# one is how PostgreSQL is initialised, the other is how Django connects.
POSTGRES_USER=kinder
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=kinder

# Production only. The domain Caddy requests a certificate for. Its A record
# must already point at the server, or the request fails and retries slowly.
# DJANGO_ALLOWED_HOSTS and DJANGO_CSRF_TRUSTED_ORIGINS have to include it —
# scripts/deploy.sh refuses to deploy if they do not.
DOMAIN=example.mn

# Celery / Redis
REDIS_URL=redis://redis:6379/0

# S3-compatible object storage. MinIO stands in for development.
# ⚠ The bucket MUST be private — RFP §4.4, §21.10
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=kinder-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=auto
MEDIA_SIGNED_URL_TTL=300

# Hand the browser a signed URL (true) or stream the file through Django
# (false). Both run the permission check first — this only decides who moves
# the bytes. Production wants true so the object store does the transfer.
# Development overrides it to false in config/settings/dev.py: MinIO signs
# for "minio:9000", a hostname only the containers can resolve.
MEDIA_REDIRECT_SIGNED_URL=true

# Upload limits
MAX_UPLOAD_SIZE_MB=25

# Failed-login throttling — RFP §3.1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# How long generated PDFs are kept — spec section 8
REPORT_RETENTION_DAYS=30

# --- Email (RFP §3.1 password reset) ---------------------------------------
# Production must set EMAIL_HOST and its credentials, or the first reset
# attempt raises instead of quietly dropping the message.
# Development overrides the backend to the console in config/settings/dev.py.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Бяцхан нүүдэлчид <noreply@example.mn>
